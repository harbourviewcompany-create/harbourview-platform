{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/applicability-rule.schema.json",
  "title": "Applicability Rule DSL",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_key",
    "version",
    "obligation_id",
    "risk_tier",
    "required_inputs",
    "when",
    "unless",
    "result_policy"
  ],
  "properties": {
    "rule_key": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "obligation_id": {
      "type": "string",
      "format": "uuid"
    },
    "risk_tier": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "required_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "when": {
      "$ref": "#/$defs/expression"
    },
    "unless": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expression"
      }
    },
    "result_policy": {
      "type": "object",
      "required": [
        "missing_input",
        "conflict",
        "default"
      ],
      "properties": {
        "missing_input": {
          "enum": [
            "insufficient_information",
            "review_required"
          ]
        },
        "conflict": {
          "enum": [
            "conflicting_evidence",
            "review_required"
          ]
        },
        "default": {
          "enum": [
            "applies",
            "does_not_apply",
            "potentially_applies"
          ]
        }
      },
      "additionalProperties": false
    },
    "explanation_template": {
      "type": "string"
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {}
        },
        {
          "type": "object"
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact",
            "operator",
            "value"
          ],
          "properties": {
            "fact": {
              "type": "string"
            },
            "operator": {
              "enum": [
                "eq",
                "neq",
                "in",
                "not_in",
                "contains",
                "exists",
                "gt",
                "gte",
                "lt",
                "lte",
                "before",
                "after",
                "overlaps"
              ]
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          }
        }
      ]
    }
  }
}
