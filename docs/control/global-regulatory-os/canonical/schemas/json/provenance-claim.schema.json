{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/provenance-claim.schema.json",
  "title": "Provenance-backed Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "truth_class",
    "claim_text",
    "status",
    "visibility",
    "classification",
    "evidence"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "truth_class": {
      "enum": [
        "source_fact",
        "normalized_fact",
        "interpretation",
        "estimate",
        "forecast",
        "recommendation"
      ]
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "structured_claim": {
      "type": "object"
    },
    "jurisdiction_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "under_review",
        "approved",
        "published",
        "superseded",
        "corrected",
        "retracted",
        "rejected"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "registered",
        "tenant",
        "restricted",
        "privileged"
      ]
    },
    "classification": {
      "type": "string"
    },
    "review": {
      "type": "object",
      "properties": {
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "legal_review_required": {
          "type": "boolean"
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "passage_id",
          "relationship",
          "stable_anchor",
          "snapshot"
        ],
        "properties": {
          "passage_id": {
            "type": "string",
            "format": "uuid"
          },
          "relationship": {
            "enum": [
              "supports",
              "contradicts",
              "context",
              "methodology"
            ]
          },
          "stable_anchor": {
            "type": "string"
          },
          "page_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "section_identifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "quoted_passage": {
            "type": [
              "string",
              "null"
            ]
          },
          "citation_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "snapshot": {
            "type": "object",
            "required": [
              "snapshot_id",
              "content_hash",
              "retrieved_at",
              "storage_uri"
            ],
            "properties": {
              "snapshot_id": {
                "type": "string",
                "format": "uuid"
              },
              "content_hash": {
                "type": "string",
                "minLength": 32
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "storage_uri": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
