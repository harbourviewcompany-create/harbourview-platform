{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/ai-model-card.schema.json",
  "title": "AI Model Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_key",
    "version",
    "provider",
    "purpose",
    "permitted_tasks",
    "prohibited_tasks",
    "permitted_data_classes",
    "maximum_risk_class",
    "evaluation_requirements",
    "human_review",
    "status"
  ],
  "properties": {
    "model_key": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "deployment_region": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "permitted_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibited_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permitted_data_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maximum_risk_class": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "training_data_position": {
      "type": "string"
    },
    "retention_position": {
      "type": "string"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluation_requirements": {
      "type": "object",
      "required": [
        "citation_entailment",
        "unsupported_claim_rate",
        "jurisdiction_tests",
        "language_tests",
        "injection_tests"
      ],
      "properties": {
        "citation_entailment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unsupported_claim_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "jurisdiction_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "injection_tests": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "human_review": {
      "type": "object",
      "required": [
        "required_from_risk_class"
      ],
      "properties": {
        "required_from_risk_class": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F"
          ]
        },
        "dual_review_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "rollback_model_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "owner_subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "draft",
        "evaluation",
        "approved",
        "suspended",
        "retired"
      ]
    }
  }
}
