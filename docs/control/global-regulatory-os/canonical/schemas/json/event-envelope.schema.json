{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/event-envelope.schema.json",
  "title": "CloudEvents-compatible Domain Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "time",
    "datacontenttype",
    "classification",
    "evidence_ids",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+\\.v[1-9][0-9]*$"
    },
    "source": {
      "type": "string",
      "format": "uri-reference"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "jurisdiction_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "data": {
      "type": "object"
    }
  }
}
