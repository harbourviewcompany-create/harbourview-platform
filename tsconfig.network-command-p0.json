{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "types": ["node", "react", "react-dom", "next"]
  },
  "include": [
    "lib/network/**/*.ts",
    "app/api/network/**/*.ts",
    "app/dashboard/network/**/*.tsx",
    "app/network/**/*.tsx",
    "components/network/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "src",
    "supabase/functions",
    "tools",
    ".next"
  ]
}
