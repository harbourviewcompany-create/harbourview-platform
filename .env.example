# Harbourview local environment example
# Copy to .env.local for local development. Do not commit .env.local or real secrets.

# =============================================================================
# Harbourview public runtime config
# Safe for browser exposure. These values may be bundled into the client.
# =============================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_HARBOURVIEW_INTERACTIVE_GLOBE=true
NEXT_PUBLIC_HARBOURVIEW_AI_GATEWAY_ENABLED=false
NEXT_PUBLIC_HARBOURVIEW_MARKETPLACE_AI_ENABLED=false


# =============================================================================
# Unified AI Gateway server-only config
# Never expose these through NEXT_PUBLIC_*.
# =============================================================================

UNIFIED_AI_GATEWAY_ENABLED=false
UNIFIED_AI_GATEWAY_BASE_URL=
UNIFIED_AI_GATEWAY_API_KEY=
UNIFIED_AI_GATEWAY_TIMEOUT_MS=30000
UNIFIED_AI_GATEWAY_MAX_RETRIES=2

UNIFIED_AI_GATEWAY_DEFAULT_PROVIDER=
UNIFIED_AI_GATEWAY_DEFAULT_MODEL=
UNIFIED_AI_GATEWAY_EMBEDDING_MODEL=

HARBOURVIEW_AI_GATEWAY_SHARED_SECRET=
HARBOURVIEW_AI_GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

HARBOURVIEW_MARKETPLACE_AI_ENABLED=false
HARBOURVIEW_MARKETPLACE_AI_REVIEW_MODE=draft
HARBOURVIEW_MARKETPLACE_AI_MAX_INPUT_CHARS=12000


# =============================================================================
# Provider/API secrets used by the gateway layer only
# Include only the providers you actually enable.
# =============================================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=


# =============================================================================
# Connected operating-system secrets
# Server-side only. Do not expose to browser code.
# =============================================================================

NOTION_TOKEN=
LINEAR_API_KEY=


# =============================================================================
# Existing Harbourview server-only Supabase/admin controls
# =============================================================================

SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# Existing Harbourview smoke/verification controls
# Usually unset locally unless intentionally running verification.
# =============================================================================

HARBOURVIEW_SMOKE_BASE_URL=http://localhost:3000
HARBOURVIEW_SMOKE_WRITE=0
HARBOURVIEW_SMOKE_CLEANUP=0
HARBOURVIEW_ALLOW_PRODUCTION_SMOKE_WRITES=0
HARBOURVIEW_SMOKE_MARKER=

# =============================================================================
# Marketplace bot-friction challenge control
# Leave MARKETPLACE_FORM_CHALLENGE_TOKEN unset until a real client challenge
# mechanism is implemented. Public client submissions currently do not send a
# challenge_token; setting this value rejects those submissions while preserving
# server-side bot controls for deployments that provide the token.
# =============================================================================
# MARKETPLACE_FORM_CHALLENGE_TOKEN=
# =============================================================================
# Marketplace inquiry notifications (Resend)
# RESEND_API_KEY: your Resend API key (https://resend.com/api-keys)
# HARBOURVIEW_MARKETPLACE_NOTIFY_EMAIL: address that receives inquiry alerts
# HARBOURVIEW_NOTIFY_FROM_EMAIL: verified sender — must match a Resend domain
#   or use onboarding@resend.dev for sandbox testing
# =============================================================================

RESEND_API_KEY=
HARBOURVIEW_MARKETPLACE_NOTIFY_EMAIL=
HARBOURVIEW_NOTIFY_FROM_EMAIL=

# =============================================================================
# Marketplace feed overrides (optional — leave unset to use live DB)
# If set, these URLs are fetched at runtime and override DB records for their
# respective category. Must be https:// and return a JSON array of records.
# =============================================================================

# HARBOURVIEW_BUSINESS_OPPORTUNITIES_FEED_URL=
# HARBOURVIEW_CONSUMABLES_FEED_URL=

# =============================================================================
# Scrape engine
# CRON_SECRET: random secret string — set same value in Vercel env vars.
#   Vercel passes this as Authorization: Bearer <CRON_SECRET> to cron routes.
# ANTHROPIC_API_KEY: your Anthropic API key for AI listing normalisation.
# =============================================================================

CRON_SECRET=
ANTHROPIC_API_KEY=

# =============================================================================
# Site URL (used in digest email links)
# =============================================================================

NEXT_PUBLIC_SITE_URL=https://harbourview-platform.vercel.app
