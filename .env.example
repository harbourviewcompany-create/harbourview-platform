# Harbourview local environment example
# Copy to .env.local for local development. Never commit .env.local or secret values.
#
# Machine-readable authority: config/environment-manifest.json
# Deployment placement: docs/deployment/CLOUDFLARE.md
#
# This file is provider-neutral. Vercel remains the production web authority,
# while the current Cloudflare Worker is only the separate `harbourview`
# intelligence/health utility.

# =============================================================================
# Public application configuration — browser-safe
# =============================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side alias accepted by a few helpers. Leave unset when
# NEXT_PUBLIC_SUPABASE_URL already points at the canonical Harbourview project.
SUPABASE_URL=

# Globe feature flags. Code defaults are shown here explicitly.
NEXT_PUBLIC_HARBOURVIEW_INTERACTIVE_GLOBE=true
NEXT_PUBLIC_HARBOURVIEW_GLOBE_COUNTRY_CARDS=true
NEXT_PUBLIC_HARBOURVIEW_GLOBE_EXPANDED_MODE=true
NEXT_PUBLIC_HARBOURVIEW_GLOBE_BEAM=true
NEXT_PUBLIC_HARBOURVIEW_GLOBE_WATER=true
NEXT_PUBLIC_HARBOURVIEW_GLOBE_FORCE_FALLBACK=false
NEXT_PUBLIC_HARBOURVIEW_GLOBE_REGULATORY_TIERS=true

# Sentry browser DSN is not a credential secret.
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# Supabase server-side secrets
# =============================================================================

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# =============================================================================
# Admin / operator controls
# =============================================================================

HARBOURVIEW_ADMIN_REVIEW_ENABLED=false
HARBOURVIEW_EDGE_OPERATOR_SECRET=

# Internal debug controller. Do not promote this non-NEXT_PUBLIC client reference
# into a public production feature flag without correcting the component contract.
HARBOURVIEW_INTERNAL_GLOBE_CONTROLLER=false

# =============================================================================
# Cron route authorization
# =============================================================================

# Required by protected /api/cron/* routes. The same secret may be stored in the
# scheduler/CI secret store that calls those routes. Cloudflare's standalone
# health Worker does not schedule these routes.
CRON_SECRET=

# =============================================================================
# Distributed rate limiting — production-equivalent server runtime
# =============================================================================

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Marketplace / notification configuration
# =============================================================================

RESEND_API_KEY=
HARBOURVIEW_TO_EMAIL=
HARBOURVIEW_FROM_EMAIL=
HARBOURVIEW_MARKETPLACE_NOTIFY_EMAIL=
HARBOURVIEW_ORG_NOTIFY_EMAIL=
HARBOURVIEW_PIPELINE_REVIEW_NOTIFY_EMAIL=

# Optional external feed overrides. Leave unset to use database-backed data.
# HARBOURVIEW_BUSINESS_OPPORTUNITIES_FEED_URL=
# HARBOURVIEW_CONSUMABLES_FEED_URL=

# Intentionally unset until a real compatible client challenge exists.
# Setting this prematurely rejects current public submissions.
# MARKETPLACE_FORM_CHALLENGE_TOKEN=

# =============================================================================
# Protected smoke/verification controls
# =============================================================================

HARBOURVIEW_SMOKE_BASE_URL=http://localhost:3000
HARBOURVIEW_SMOKE_WRITE=0
HARBOURVIEW_SMOKE_CLEANUP=0
HARBOURVIEW_SMOKE_ROUTE_SECRET=
HARBOURVIEW_ALLOW_PRODUCTION_SMOKE_WRITES=0
HARBOURVIEW_SMOKE_MARKER=

# =============================================================================
# Unified AI Gateway — server-only unless a field is explicitly public
# =============================================================================

UNIFIED_AI_GATEWAY_ENABLED=false
UNIFIED_AI_GATEWAY_BASE_URL=
UNIFIED_AI_GATEWAY_API_KEY=
UNIFIED_AI_GATEWAY_TIMEOUT_MS=30000
UNIFIED_AI_GATEWAY_MAX_RETRIES=2
UNIFIED_AI_GATEWAY_DEFAULT_PROVIDER=
UNIFIED_AI_GATEWAY_DEFAULT_MODEL=
UNIFIED_AI_GATEWAY_EMBEDDING_MODEL=

HARBOURVIEW_AI_GATEWAY_SHARED_SECRET=
HARBOURVIEW_AI_GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
HARBOURVIEW_MARKETPLACE_AI_ENABLED=false
HARBOURVIEW_MARKETPLACE_AI_REVIEW_MODE=draft
HARBOURVIEW_MARKETPLACE_AI_MAX_INPUT_CHARS=12000

# =============================================================================
# LLM runtime — server-only
# =============================================================================

HARBOURVIEW_LLM_GATEWAY_ENABLED=0
HARBOURVIEW_LLM_DEFAULT_PROVIDER=anthropic
HARBOURVIEW_LLM_TIMEOUT_MS=20000
HARBOURVIEW_LLM_RATE_LIMIT_PER_MINUTE=12

# Optional provider model overrides used by lib/llm/config.ts.
HARBOURVIEW_LLM_ANTHROPIC_MODEL=
HARBOURVIEW_LLM_GEMINI_MODEL=
HARBOURVIEW_LLM_MOONSHOT_MODEL=
HARBOURVIEW_LLM_DEEPSEEK_MODEL=

# Provider credentials. Configure only providers actually used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
HARBOURVIEW_XAI_ROUTE_SECRET=

# =============================================================================
# Hugging Face intelligence layer — server-only
# =============================================================================

# Never create NEXT_PUBLIC_HF* or NEXT_PUBLIC_HUGGINGFACE* variables.
HF_ORG=Harbourview
HF_TOKEN_SERVER=
# HF_TOKEN is deprecated and intentionally unsupported. Do not add it.
HUGGINGFACE_ORG_SLUG=

HF_ENDPOINT_EMBED_BGE_M3=
HF_ENDPOINT_RERANK_BGE_V2_M3=
HF_ENDPOINT_EXTRACT_QWEN3_4B=
HF_ENDPOINT_EXTRACT_QWEN3_30B=

HF_DATASET_SOURCE_CORPUS=Harbourview/hv-source-corpus-private
HF_DATASET_EVALS=Harbourview/hv-eval-sets-private
HF_DATASET_REVIEWED_FACTS=Harbourview/hv-reviewed-facts-private
HF_DATASET_RELEASE_CANDIDATES=Harbourview/hv-release-candidates-private

# =============================================================================
# Connected server-side integrations
# =============================================================================

NOTION_TOKEN=
LINEAR_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# =============================================================================
# Observability — Sentry
# =============================================================================

SENTRY_DSN=
# Build-only source-map upload configuration; optional.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =============================================================================
# Stripe billing — server-only secrets + plain Price IDs
# =============================================================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INTEL_MONTHLY=
STRIPE_PRICE_INTEL_ANNUAL=
STRIPE_PRICE_OPERATOR_MONTHLY=
STRIPE_PRICE_OPERATOR_ANNUAL=

# The legacy STRIPE_PRICE_STARTER_*, STRIPE_PRICE_PRO_* and
# STRIPE_PRICE_ENTERPRISE variables belong to an unused module and are not part
# of the current billing path. Do not provision them for this application.

# =============================================================================
# Persistent intelligence Worker daemon (non-Cloudflare hosts only)
# =============================================================================

# WorkerNode's Node HTTP health server defaults to 8080 and is started only by
# the persistent daemon path. Cloudflare Workers do not bind a TCP port.
PORT=8080

# =============================================================================
# Cloudflare standalone intelligence/health Worker
# =============================================================================

# Root wrangler.toml commits NODE_ENV=production and
# INTELLIGENCE_WORKER_ID=cf-worker-01. Its runtime dashboard additionally needs:
#   NEXT_PUBLIC_SUPABASE_URL        -> Variable
#   SUPABASE_SERVICE_ROLE_KEY       -> Secret
#
# WORKER_BATCH_SIZE is optional and inert while the Worker has no Cron Trigger.
# Do not add Cloudflare Cron Triggers while Supabase pg_cron owns ingestion.
WORKER_BATCH_SIZE=
