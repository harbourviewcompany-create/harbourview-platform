# Harbourview local environment example
# Copy to .env.local for local development. Do not commit .env.local or real secrets.

# =============================================================================
# Harbourview public runtime config
# Safe for browser exposure. These values may be bundled into the client.
# =============================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production value (set in Vercel, not here): https://harbourview.vercel.app
# Also used for digest email links — do not redefine this var elsewhere in
# this file (see note below near the removed duplicate for history).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# Supabase server-side secrets (never expose to browser)
# =============================================================================

# Required for IA admin pages (agents, scoring, routing, evidence, etc.)
# to read live data from Supabase IA tables (bypasses RLS as service role).
# Find in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Required for server-side Supabase client (auth helpers, server actions)
SUPABASE_JWT_SECRET=

NEXT_PUBLIC_HARBOURVIEW_INTERACTIVE_GLOBE=true
NEXT_PUBLIC_HARBOURVIEW_AI_GATEWAY_ENABLED=false
NEXT_PUBLIC_HARBOURVIEW_MARKETPLACE_AI_ENABLED=false


# =============================================================================
# Unified AI Gateway server-only config
# Never expose these through NEXT_PUBLIC_*.
# =============================================================================

UNIFIED_AI_GATEWAY_ENABLED=false
UNIFIED_AI_GATEWAY_BASE_URL=
UNIFIED_AI_GATEWAY_API_KEY=
UNIFIED_AI_GATEWAY_TIMEOUT_MS=30000
UNIFIED_AI_GATEWAY_MAX_RETRIES=2

UNIFIED_AI_GATEWAY_DEFAULT_PROVIDER=
UNIFIED_AI_GATEWAY_DEFAULT_MODEL=
UNIFIED_AI_GATEWAY_EMBEDDING_MODEL=

HARBOURVIEW_AI_GATEWAY_SHARED_SECRET=
HARBOURVIEW_AI_GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

HARBOURVIEW_MARKETPLACE_AI_ENABLED=false
HARBOURVIEW_MARKETPLACE_AI_REVIEW_MODE=draft
HARBOURVIEW_MARKETPLACE_AI_MAX_INPUT_CHARS=12000


# =============================================================================
# Provider/API secrets used by the gateway layer only
# Include only the providers you actually enable.
# =============================================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
HARBOURVIEW_XAI_ROUTE_SECRET=


# =============================================================================
# Connected operating-system secrets
# Server-side only. Do not expose to browser code.
# =============================================================================

NOTION_TOKEN=
LINEAR_API_KEY=


# =============================================================================
# Existing Harbourview server-only Supabase/admin controls
# =============================================================================

# SUPABASE_SERVICE_ROLE_KEY is defined above in "Supabase server-side secrets".
# Do not duplicate it here — shell `source` will silently use the last value.


# =============================================================================
# Existing Harbourview smoke/verification controls
# Usually unset locally unless intentionally running verification.
# =============================================================================

HARBOURVIEW_SMOKE_BASE_URL=http://localhost:3000
HARBOURVIEW_SMOKE_WRITE=0
HARBOURVIEW_SMOKE_CLEANUP=0
# Caller secret required by /api/smoke/marketplace when smoke write checks are enabled.
HARBOURVIEW_SMOKE_ROUTE_SECRET=
HARBOURVIEW_ALLOW_PRODUCTION_SMOKE_WRITES=0
HARBOURVIEW_SMOKE_MARKER=

# =============================================================================
# Marketplace bot-friction challenge control
# Leave MARKETPLACE_FORM_CHALLENGE_TOKEN unset until a real client challenge
# mechanism is implemented. Public client submissions currently do not send a
# challenge_token; setting this value rejects those submissions while preserving
# server-side bot controls for deployments that provide the token.
# =============================================================================
# MARKETPLACE_FORM_CHALLENGE_TOKEN=
# =============================================================================
# Marketplace inquiry notifications (Resend)
# RESEND_API_KEY: your Resend API key (https://resend.com/api-keys)
# HARBOURVIEW_MARKETPLACE_NOTIFY_EMAIL: address that receives inquiry alerts
# HARBOURVIEW_NOTIFY_FROM_EMAIL: verified sender — must match a Resend domain
#   or use onboarding@resend.dev for sandbox testing
# =============================================================================

RESEND_API_KEY=
HARBOURVIEW_MARKETPLACE_NOTIFY_EMAIL=
HARBOURVIEW_NOTIFY_FROM_EMAIL=

# =============================================================================
# Marketplace feed overrides (optional — leave unset to use live DB)
# If set, these URLs are fetched at runtime and override DB records for their
# respective category. Must be https:// and return a JSON array of records.
# =============================================================================

# HARBOURVIEW_BUSINESS_OPPORTUNITIES_FEED_URL=
# HARBOURVIEW_CONSUMABLES_FEED_URL=

# =============================================================================
# Scrape engine
# CRON_SECRET: random secret string — set same value in Vercel env vars.
#   Vercel passes this as Authorization: Bearer <CRON_SECRET> to cron routes.
# ANTHROPIC_API_KEY: your Anthropic API key for AI listing normalisation.
# =============================================================================

CRON_SECRET=
ANTHROPIC_API_KEY=

# =============================================================================
# Site URL (used in digest email links)
# NEXT_PUBLIC_SITE_URL is already defined near the top of this file, under
# "Harbourview public runtime config". Do not redefine it here — shell
# `source` will silently use the last value, and a stale second definition
# previously pointed at the legacy harbourview-platform.vercel.app domain
# instead of the canonical harbourview.vercel.app. In Vercel, set this env
# var once per environment (Production: https://harbourview.vercel.app).
# =============================================================================

# ── Admin review ──────────────────────────────────────────────────────────────
# Set HARBOURVIEW_ADMIN_REVIEW_ENABLED=true to enable the admin inquiry review
# pipeline. Requires SUPABASE_SERVICE_ROLE_KEY to be set.
HARBOURVIEW_ADMIN_REVIEW_ENABLED=false

# ── Notification email (team-level vars) ─────────────────────────────────────
# HARBOURVIEW_TO_EMAIL: address that receives all platform notifications
# HARBOURVIEW_FROM_EMAIL: verified sender address (must match a Resend domain)
HARBOURVIEW_TO_EMAIL=
HARBOURVIEW_FROM_EMAIL=

# ── LLM configuration ────────────────────────────────────────────────────────
# HARBOURVIEW_LLM_GATEWAY_ENABLED: set to 1 to route LLM calls through the AI gateway
# HARBOURVIEW_LLM_DEFAULT_PROVIDER: default provider slug (anthropic, openai, etc.)
# HARBOURVIEW_LLM_TIMEOUT_MS: request timeout in milliseconds (default 30000)
# HARBOURVIEW_LLM_RATE_LIMIT_PER_MINUTE: max LLM calls per minute (default 20)
HARBOURVIEW_LLM_GATEWAY_ENABLED=0
HARBOURVIEW_LLM_DEFAULT_PROVIDER=anthropic
HARBOURVIEW_LLM_TIMEOUT_MS=30000
HARBOURVIEW_LLM_RATE_LIMIT_PER_MINUTE=20

# =============================================================================
# Intelligence extraction pipeline (free tier — zero cost)
# Pipeline: intelligence-ingest (02:00 UTC) -> intelligence-extract (04:00 UTC)
#           -> embed-artifacts (05:00 UTC)
# =============================================================================

# GEMINI_API_KEY: required by app/api/cron/intelligence-extract and
# lib/ai/intelligence-processor.ts for structured extraction (gemini-2.5-flash).
# Get a free key (no billing required) at: https://aistudio.google.com/apikey
# Free tier limits (subject to change): ~15 requests/min, ~500 requests/day.
# Without this set, the extract cron returns ok:false and does nothing.
GEMINI_API_KEY=


# =============================================================================
# Hugging Face Intelligence Layer — server-only
# NEVER add NEXT_PUBLIC_HF_* variables. All HF access is server-only.
# See: docs/OPERATING_AUTHORITY.md
# See: lib/hf/env.ts for Zod schema and validation
# =============================================================================

# HF org slug (always Harbourview — do not change)
HF_ORG=Harbourview

# HF server token — read access to private Harbourview org repos and endpoints
# Generate at: https://huggingface.co/settings/tokens
# Required scope: read (repos + inference endpoints)
HF_TOKEN_SERVER=

# Inference endpoint URLs — set once dedicated endpoints are provisioned
# (Ticket 7+, paid). Until then, app/api/cron/embed-artifacts uses HF_TOKEN_SERVER
# alone against the free serverless inference API (sentence-transformers/
# all-MiniLM-L6-v2, 384-dim) — no cost, no endpoint required.
HF_ENDPOINT_EMBED_BGE_M3=
HF_ENDPOINT_RERANK_BGE_V2_M3=
HF_ENDPOINT_EXTRACT_QWEN3_4B=
HF_ENDPOINT_EXTRACT_QWEN3_30B=

# Dataset repo identifiers (defaults are set in lib/hf/env.ts — only override if needed)
HF_DATASET_SOURCE_CORPUS=Harbourview/hv-source-corpus-private
HF_DATASET_EVALS=Harbourview/hv-eval-sets-private
HF_DATASET_REVIEWED_FACTS=Harbourview/hv-reviewed-facts-private
HF_DATASET_RELEASE_CANDIDATES=Harbourview/hv-release-candidates-private

# =============================================================================
# Edge operator / admin verification (server-only secret)
# Read by app/api/admin/verify-org/route.ts to authorize org-verification calls.
# Was previously undocumented — set this in every deployment that exposes the
# admin verify-org route, or that route will reject all callers.
# =============================================================================

HARBOURVIEW_EDGE_OPERATOR_SECRET=

# =============================================================================
# Observability — Sentry (error tracking + performance tracing)
# See sentry.client.config.ts / sentry.server.config.ts / sentry.edge.config.ts
# and next.config.mjs (withSentryConfig). If unset, Sentry no-ops safely.
# =============================================================================

# Safe to expose to the browser — DSNs accept writes only, they're not secret.
NEXT_PUBLIC_SENTRY_DSN=
# Server-only DSN override; falls back to NEXT_PUBLIC_SENTRY_DSN if unset.
SENTRY_DSN=
# Only needed to enable source map upload during `next build` (CI/Vercel).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =============================================================================
# Rate limiting — Upstash Redis
# Backs lib/network/rateLimit.ts (enforceRateLimit / getClientIp), used by
# admin login, marketplace intake routes, watchlist, org creation, and signal
# subscriptions. WITHOUT these set, rate limiting silently falls back to
# process-local in-memory tracking, which does NOT enforce a real limit
# across serverless instances — set these in every real deployment.
# =============================================================================

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Stripe billing (server-only secrets + price IDs)
# Was previously undocumented despite being live-imported by app/account/page.tsx
# and app/api/stripe/{checkout,webhook,portal}/route.ts. Both files fail fast
# with a clear error at request time if STRIPE_SECRET_KEY is unset (no build-time
# crash, no silent failure) — see lib/stripe/server.ts.
#
# lib/billing/stripe.ts is a separate, unused Stripe module with its own price-ID
# vars (STRIPE_PRICE_ENTERPRISE/PRO_*/STARTER_*, STRIPE_PRICE_TIER_MAP) — it has
# zero importers anywhere in the app and is not part of the live billing path.
# Do not set those vars for this app; they belong to dead code, not this one.
# =============================================================================

# Find in: Stripe Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=

# Find in: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# Endpoint URL: <deployment>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Price IDs for the two live subscription tiers (Intel Plus, Operator), each
# with a monthly and annual price. Find in: Stripe Dashboard → Product catalog,
# or create via the one-time /admin/stripe-setup wizard (admin-only).
STRIPE_PRICE_INTEL_MONTHLY=
STRIPE_PRICE_INTEL_ANNUAL=
STRIPE_PRICE_OPERATOR_MONTHLY=
STRIPE_PRICE_OPERATOR_ANNUAL=

# Fallback origin for Stripe checkout/portal redirect URLs when the request has
# no Origin header. Falls back to https://harbourview.network if also unset, so
# this is not strictly required — but set it explicitly per deployment to avoid
# redirecting a preview/staging checkout back to the production domain.
NEXT_PUBLIC_APP_URL=
