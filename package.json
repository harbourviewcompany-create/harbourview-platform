{
  "name": "harbourview-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:globe-router && npm run test:country-role && vitest run tests/harbourview/public-dom-forbidden-strings.test.tsx tests/harbourview/public-route-smoke.test.ts",
    "vercel-ignore-build": "bash scripts/vercel-ignore-wbcc-only.sh",
    "test:globe-router": "vitest run tests/globe-router.test.ts tests/globe-foundation.test.ts tests/globe-polygon-rendering.test.ts tests/globe-natural-earth-countries.test.ts tests/globe-visual-state.test.ts && node scripts/test-globe-router-scope.mjs && node scripts/test-globe-router-mounted.mjs",
    "test:visibility": "node scripts/test-public-provenance-visibility.mjs && node scripts/test-business-opportunities-public-leakage.mjs",
    "test:listing-quality": "node scripts/test-listing-quality.mjs",
    "test:public-images": "node scripts/test-public-image-assets.mjs",
    "test:compliance-visibility": "node scripts/test-compliance-visibility.mjs",
    "test:clinical-education": "node scripts/test-clinical-education-guardrails.mjs",
    "test:signals-public-leakage": "node scripts/run-signals-public-leakage-local.mjs",
    "test:signals-public-leakage:direct": "node scripts/test-signals-public-leakage.mjs",
    "test:regulatory-signals-public-leakage": "node scripts/test-regulatory-signals-public-leakage.mjs",
    "test:regulatory-signals-contract": "node scripts/test-regulatory-signals-contract.mjs",
    "test:admin-guard": "node scripts/test-admin-role-guard.mjs && node scripts/test-admin-role-logic.mjs && node scripts/test-marketplace-conversion-workflow.mjs && node scripts/test-smoke-marketplace-route-guard.mjs",
    "test:admin-dashboard": "node scripts/test-admin-role-guard.mjs && node scripts/test-playwright-public-and-admin-access.mjs",
    "test:live-source-intake": "node scripts/test-live-source-intake.mjs",
    "test:new-products-equipment-intake": "node scripts/test-new-products-equipment-intake.mjs",
    "test:intake-workflow-safety": "node scripts/test-live-source-intake.mjs && node scripts/test-new-products-equipment-intake.mjs && node scripts/test-intake-workflow-safety.mjs",
    "test:services-public-leakage": "node scripts/test-services-public-leakage.mjs",
    "test:intelligence-fixtures": "node scripts/test-intelligence-fixture-projection.mjs",
    "test:intelligence-globe-leakage": "node scripts/test-intelligence-globe-public-leakage.mjs",
    "test:used-surplus-public-leakage": "node scripts/test-used-surplus-public-leakage.mjs",
    "test:genetics-profile-redaction": "node scripts/test-genetics-profile-redaction.mjs",
    "test:genetics-routing": "node scripts/test-genetics-routing-logic.mjs",
    "test:intelligence-os": "vitest run tests/intelligence-os/extraction.test.ts",
    "test:e2e": "npx -y -p @playwright/test@1.54.0 playwright test",
    "test:full-scope:script-uniqueness": "node scripts/test-package-script-uniqueness.mjs",
    "test:full-scope:routes": "node scripts/test-route-capability-registry.mjs",
    "test:full-scope:content": "node scripts/test-content-inventory.mjs",
    "test:full-scope:education": "node scripts/test-clinical-education-review-metadata.mjs",
    "test:full-scope:compliance": "node scripts/test-compliance-country-status-labels.mjs",
    "test:full-scope:marketplace": "node scripts/test-marketplace-category-capability-map.mjs",
    "test:full-scope:fallbacks": "node scripts/test-fallback-live-indicators.mjs",
    "test:full-scope-launch-readiness": "node scripts/test-full-scope-launch-readiness.mjs",
    "probe:production-visibility": "node scripts/probe-production-provenance-visibility.mjs && node scripts/probe-production-client-bundles.mjs",
    "verify:leakage": "npm run test:visibility && node scripts/probe-public-leakage.mjs",
    "verify:admin-auth": "npm run test:admin-guard",
    "verify:marketplace-smoke": "npm run smoke:marketplace",
    "verify:production-visibility": "npm run probe:production-visibility",
    "smoke:marketplace": "node scripts/smoke-marketplace.mjs",
    "smoke:marketplace:rls": "node scripts/smoke-marketplace-rls.mjs",
    "smoke:marketplace:browser": "node scripts/smoke-marketplace-browser.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:secret-scan": "node scripts/secret-scan.mjs",
    "check:migrations": "node scripts/check-migration-filenames.mjs",
    "verify:all-safe": "npm run typecheck && npm run lint && npm run test:intelligence-os && npm run test:visibility && npm run verify:leakage && npm run verify:admin-auth && npm run build",
    "test:playwright:public-access": "node scripts/test-playwright-public-and-admin-access.mjs",
    "test:globe-router:browser": "BASE_URL=http://127.0.0.1:3000 node scripts/test-globe-router-browser.mjs",
    "qa:all": "node scripts/qa-registry.mjs --bundle=all",
    "qa:public-surface": "node scripts/qa-registry.mjs --bundle=public-surface",
    "qa:compliance": "node scripts/qa-registry.mjs --bundle=compliance",
    "qa:smoke": "node scripts/qa-registry.mjs --bundle=smoke",
    "test:public-copy-dedup": "node scripts/test-public-copy-dedup.mjs",
    "source-import:build": "tsx scripts/source-import/build-source-import-batches.ts",
    "source-import:push": "tsx scripts/source-import/push-source-import-batches.ts",
    "source-import:dry-run": "SOURCE_IMPORT_DRY_RUN=1 tsx scripts/source-import/push-source-import-batches.ts",
    "test:country-role": "vitest run tests/roles/country-role-resolver.test.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.8",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.108.0",
    "next": "^15.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.2.0",
    "three": "^0.174.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.174.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0",
    "wrangler": "^4.100.0"
  }
}
