{
  "schemaVersion": 1,
  "parentManifest": "config/environment-manifest.json",
  "scope": "Workflow-local environment variables that are referenced by .github/workflows but are not application/runtime infrastructure variables. Common provider credentials and platform variables remain classified in the parent manifest.",
  "groups": [
    {
      "id": "workflow-local-plain",
      "names": [
        "ARTIFACT_DIR",
        "ASSERTION_FILE",
        "BASE_SHA",
        "BASE_URL",
        "BEFORE",
        "CLINICAL_CALCULATOR_REVIEW_APPROVED",
        "CLINICAL_TEST_API_URL",
        "CONFIRMATION",
        "DECISION_INTEL_EVENT_ID",
        "DRY_RUN",
        "E2E_INVITER_EMAIL",
        "E2E_TEST_USER_EMAIL",
        "EXPECTED_COMMIT",
        "EXPECTED_DEPLOYMENT_ID",
        "EXPECTED_ENVIRONMENT",
        "EXPECTED_GIT_SHA",
        "EXPECTED_PROJECT_ID",
        "GITHUB_ENV",
        "HARBOURVIEW_DEPLOYMENT_ID",
        "HARBOURVIEW_DEPLOYMENT_URL",
        "HARBOURVIEW_EXPECTED_COMMIT",
        "HARBOURVIEW_EXTRA_API_GET_ROUTES",
        "HARBOURVIEW_PRODUCTION_PROBE_ATTEMPTS",
        "HARBOURVIEW_PRODUCTION_PROBE_WAIT_MS",
        "HARBOURVIEW_PRODUCTION_URL",
        "HARBOURVIEW_PROTECTED_DOMAINS",
        "HARBOURVIEW_SCAN_DOMAINS",
        "HARBOURVIEW_SCAN_FETCH_TIMEOUT_MS",
        "HARBOURVIEW_SCAN_MAX_DISCOVERED_ROUTES",
        "HEAD_SHA",
        "HV_SIGNAL_RUNTIME_VERIFY",
        "HV_SIGNAL_VERIFY_OUTPUT",
        "INCLUDE_SECONDARY",
        "IS_CONFIRMED_MANUAL_DISPATCH",
        "IS_CONTROLLED_PROBE_BRANCH",
        "IS_CONTROLLED_SMOKE_BRANCH",
        "JURISDICTION_COMMAND_SOURCE_SHA",
        "MIGRATION_FILE",
        "MIGRATION_NAME",
        "MIGRATION_VERSION",
        "MOBILE_COMMAND_SOURCE_SHA",
        "NEXT_TELEMETRY_DISABLED",
        "ONLY",
        "PLAYWRIGHT_BASE_URL",
        "POSTGRES_DB",
        "POSTGRES_HOST_AUTH_METHOD",
        "PREVIEW_URL",
        "PRIMARY_BASE_URL",
        "PRODUCTION_URL",
        "RELEASE_EVIDENCE_SHA",
        "RELEASE_WORKFLOW_SHA",
        "RESOLVED_PROBE_BASE_URL",
        "RESOLVED_SMOKE_BASE_URL",
        "SECONDARY_BASE_URL",
        "SOURCE_BRANCH",
        "SOURCE_IMPORT_BATCH_SIZE",
        "SOURCE_IMPORT_INPUT",
        "SOURCE_IMPORT_VERSION",
        "SUPABASE_DB_SCHEMA",
        "TEST_EMAIL",
        "VERCEL_DEPLOYMENT_ID",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_IMMUTABLE_BASE_URL",
        "VERCEL_URL"
      ],
      "stage": "CI/Deploy only",
      "sensitivity": "Plain variable",
      "provider": "github-actions/workflow-local",
      "requirement": "Workflow-local input, derived value, test configuration or artifact path; not a Cloudflare/Vercel runtime environment requirement",
      "status": "live",
      "cloudflare": {
        "intelligenceHealthWorker": "Not used",
        "nextWebPreview": "CI/build orchestration only; do not copy to Worker runtime unless a future workflow explicitly requires it"
      }
    },
    {
      "id": "workflow-local-secrets",
      "names": [
        "CLINICAL_TEST_ANON_KEY",
        "CLINICAL_TEST_SERVICE_ROLE_KEY",
        "DATABASE_URL",
        "E2E_INVITER_PASSWORD",
        "E2E_TEST_USER_PASSWORD",
        "HV_SIGNAL_VERIFY_TOKEN",
        "HV_SIGNAL_VERIFY_TOKEN_CONFIRM",
        "POSTGRES_PASSWORD",
        "SUPABASE_DB_URL",
        "TEST_PASSWORD",
        "VERCEL_TRUSTED_OIDC_TOKEN"
      ],
      "stage": "CI/Deploy only",
      "sensitivity": "Secret",
      "provider": "github-actions/test-runtime",
      "requirement": "Workflow-local verification/test secret; not an application production secret contract",
      "status": "live",
      "cloudflare": {
        "intelligenceHealthWorker": "Not used",
        "nextWebPreview": "Keep in CI/test secret store; do not copy to Worker runtime"
      }
    }
  ]
}