# Harbourview production Caddy configuration
# Replace harbourview.example.com with the production domain.

harbourview.example.com {
    encode gzip zstd

    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    reverse_proxy 127.0.0.1:3000

    log {
        output file /var/log/caddy/harbourview-access.log
    }
}
