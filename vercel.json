{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "preview/*": true,
      "fix/*": false,
      "feat/*": false,
      "feature/*": false,
      "claude/*": false,
      "docs/*": false,
      "tmp/*": false,
      "agent/*": false,
      "dependabot/*": false,
      "ops/*": false,
      "codex/*": false,
      "kimi/*": false,
      "perf/*": false,
      "audit/*": false,
      "repair/*": false,
      "chore/*": false,
      "hv/*": false,
      "deps/*": false,
      "build/*": false,
      "test/*": false,
      "verify/*": false
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore-wbcc-only.sh",
  "crons": [
    {
      "path": "/api/cron/intelligence-ingest",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/intelligence-extract",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/clinical-sku-feeds",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/intelligence-embed",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/clinical-source-currentness",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/intelligence-notify",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/scrape",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/personal-briefings-tick",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/pipeline-manual-review-notify",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/intelligence-health",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/market-access-promote",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/regulatory-watch",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/prune-client-errors",
      "schedule": "0 3 * * *"
    }
  ]
}
